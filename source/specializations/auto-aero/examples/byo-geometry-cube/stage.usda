#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    # App-state prim: the typed-knob substrate the manifest control writes to.
    def Scope "AppState" (
        prepend apiSchemas = ["RtwtCubeAppStateAPI"]
    )
    {
        uniform token omni:rtwt:app_state:shape = "UnitCube"
    }

    # The geometry whose appearance the "shape" knob swaps, via a Shape variant set.
    def Xform "Cube" (
        prepend variantSets = "Shape"
        variants = {
            string Shape = "UnitCube"
        }
    )
    {
        variantSet "Shape" = {
            "UnitCube" {
                def Cube "Geom"
                {
                    double size = 1
                }
            }
            "TallCube" {
                def Cube "Geom"
                {
                    double size = 1
                    float3 xformOp:scale = (1, 3, 1)
                    uniform token[] xformOpOrder = ["xformOp:scale"]
                }
            }
        }
    }
}
