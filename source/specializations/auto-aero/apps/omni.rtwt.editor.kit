[package]
title = "RTWT Editor"
version = "2026.07"
keywords = [ "app" ]

[dependencies]
# Extends the core base app omni.rtwt.kit.
"omni.rtwt" = {}

# Automotive-aero specialization schemas (registers RtwtInferenceAppStateAPI /
# RtwtVizAppStateAPI for the aero stage).
"omni.rtwt.auto_aero.schema" = {}

# Automotive-aero specialization callbacks (registers auto_aero.dynamic_pressure into the
# controller binding engine for the colormap-domain physics).
"omni.rtwt.auto_aero.hooks" = {}

# this is a custom setting used in our app setup to choose the Layout
[settings.app.layout]
name = "none"

[settings.app.window]
title = "RTWT Editor"

[settings.persistent]
app.stage.upAxis = "Z"

[settings.app.exts]
# This list is a collection of relative paths from application to folders where
# extensions and dependencies are located.
folders.'++' = [  # Search paths for extensions.
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache",

    # Kit-CAE
    "${app}/../kit-cae/exts",
    "${app}/../kit-cae/apps",

    # For repo_precache_exts (this that happens before premake.lua,
    # we have to pass the path directly from the build dir.
    "_build/${platform}/${config}/kit-cae/exts",
    "_build/${platform}/${config}/kit-cae/apps",
]

[settings.app.extensions]
fsWatcherEnabled = true

# Skip checking supported platform/config when building
supportedTargets.platform = []

"omni.kit.viewport.navigation.camera_manipulator".defaultOperation = "orbit" # Orbit ON by default
"omni.ui".Window.enableDetach = false

"omni.kit.window.content_browser".show_download_menuitem = false

# Do not allow connections to new servers when running on OVC.
"omni.kit.window.filepicker".show_add_new_connection = false

# Do not display the buttons to open log files when running on OVC
"omni.kit.window.console".showOpenLogButtons = false

# Disable custom cursors.
"omni.kit.window.cursor".disabled = true

# Do not show the local filesystem in the content browser
"omni.kit.window.content_browser".show_only_collections = ["bookmarks", "omniverse", "",]

# Do not show the local file system in the filepicker.
"omni.kit.window.filepicker".show_only_collections = ["bookmarks", "omniverse", "",]

[settings.log]
# Sets the relative path to where the log file for this application is stored.
file = "logs/omni.rtwt.editor.log"
fileLogLevel = "info" # more verbose logging
enableStandardStreamOutput = true
outputStreamLevel = "warning"

[settings]
# Per-workflow (auto-aero specialization) settings — the stage and offline cache that
# the use-case-agnostic core base app does not carry. Runtime paths (/app/rtwt/...) are fixed.
exts."omni.cae.startup".usdFile = "${app}/../rtwt/stages/Main.usda"
exts."omni.rtwt.inference".offline_cache_dir = "${app}/../rtwt/data/cache"
# AppState API schemas this workflow's controls live on — consumed by the controller binding
# engine (for knob discovery) and the inference cache key. Core ships these empty; the auto-aero
# specialization supplies its schema vocabulary here.
exts."omni.rtwt.controller".app_state_api_schemas = ["RtwtInferenceAppStateAPI", "RtwtVizAppStateAPI"]
exts."omni.rtwt.inference".app_state_api_schemas = ["RtwtInferenceAppStateAPI"]
# Declarative workflow manifest: controls, roles, widgets, bindings, cache grid.
exts."omni.rtwt.controller".workflow_manifest = "${app}/../rtwt/workflow/workflow.toml"

rtx.occlusionDetection.enabled=true
rtx.aovConverter.disocclusionScale = 1200000
rtx.disocclusionDetection.conservativeSurfaceDetection=false
rtx.disocclusionDetection.depthThreshold = 0.085

# Do not check if the GPU drivers are verified
rtx.verifyDriverVersion.enabled = false
rtx.post.aa.op = 3
rtx.post.dlss.execMode = 1  # DLSS mode: balanced

# Disable the realm.timeout.
realm.timeout = 0
privacy.userId = "${USER_ID}"
rendergraph.maxFramesInFlight = 2 # Reduce click-to-photon
renderer.debug.aftermath.enabled = true
plugins."carb.tasking.plugin".threadCount = 16


########################################################################################################################
# BEGIN GENERATED PART (Remove from 'BEGIN' to 'END' to regenerate)
########################################################################################################################

# Kit SDK Version: 110.1.3+production.349534.56c4c3a1.gl

# Version lock for all dependencies:
[settings.app.exts]
enabled = [
	"omni.anim.curve.core-1.6.0",
	"omni.anim.window.timeline-110.0.1",
	"omni.flowusd-110.0.4",
	"omni.graph.action-2.10.2",
	"omni.graph.action_nodes-2.11.0",
	"omni.graph.action_nodes_core-2.11.0",
	"omni.graph.nodes-2.12.0",
	"omni.graph.nodes_core-2.11.0",
	"omni.kit.asset_converter-6.0.1",
	"omni.kit.livestream.messaging-1.3.1",
	"omni.kit.tool.asset_importer-6.0.1",
	"omni.kit.window.movie_capture-3.0.1",
	"omni.services.client-0.5.6",
	"omni.services.transport.client.base-1.2.5",
	"omni.services.transport.client.http_async-1.4.2",
	"omni.usd.schema.flow-110.0.0",
	"omni.warp.core-1.13.0",
]

