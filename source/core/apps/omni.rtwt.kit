[package]
title = "RTWT Core"
version = "2026.07"
description = "The use-case-agnostic core base app (extended by specialization leaf apps)."
keywords = ["app", "rtwt", "core"]

[dependencies]
# Kit-CAE application
"omni.cae" = {}

# Keep the Warp runtime aligned with Kit-CAE 3.0. Without an exact constraint,
# a warm extension cache can satisfy this dependency with the older 1.12 line.
"omni.warp.core" = { version = "1.13.0", exact = true }

# RTWT specific plugins
"omni.rtwt.schema" = {}
"omni.rtwt.controller" = {}

[settings.app]
# Show/Hide the performance counters in the upper right corner of the viewport.
viewport.forceHideFps = false

# Fill the viewport so the render covers the complete browser viewing area.
# Does not affect streaming resolution.
viewport.defaults.fillViewport = true

# hide the grid
viewport.grid.enabled = false

[settings]
# Use-case-agnostic core base app: it carries NO stage, cache, or workflow manifest.
# A specialization leaf app (e.g. the auto-aero omni.rtwt.webrtc.kit) sets usdFile,
# offline_cache_dir, and workflow_manifest. The core stays buildable and launchable
# (empty) on its own, with no specialization present.
rtx.occlusionDetection.enabled=true
rtx.aovConverter.disocclusionScale = 200000000
rtx.disocclusionDetection.depthThreshold = 0.1
rtx.post.dlss.execMode = 1

[settings.log]
# Sets the relative path to where the log file for this application is stored.
file = "logs/omni.rtwt.log"
fileLogLevel = "info"
enableStandardStreamOutput = true
outputStreamLevel = "warning"

[settings.app.exts]
folders.'++' = [  # Search paths for extensions.
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache",

    # Kit-CAE
    "${app}/../kit-cae/exts",
    "${app}/../kit-cae/apps",

    # For repo_precache_exts (this that happens before premake.lua,
    # we have to pass the path directly from the build dir.
    "_build/${platform}/${config}/kit-cae/exts",
    "_build/${platform}/${config}/kit-cae/apps",
]


